          <div class="col-sm-6">
            <div class="well well-sm brdr-rds-0 eqht-trgt" style="position: relative;">
              {% if link.image %}
                <img src="{{ link.image.url }}" alt="{{ link.image.alternate_text | h }}" class="img-responsive full-width" />
