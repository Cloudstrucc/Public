                <a href="{{ link.url | h }}" class="btn btn-ec-outline" style="margin-top: 20px;" title="{{ link.tooltip | h }}">{{ link.name | h }}</a>
              {% endif %}
            {% endfor %}
          {% else %}
            <a href="/Account/Login" class="btn btn-ec-primary" style="margin-top: 20px; margin-right: 10px;">{{ snippets['EC/HOME/BTN_REGISTER'] | default: 'Register' }}</a>
            <a href="/Account/Login" class="btn btn-ec-outline" style="margin-top: 20px;">{{ snippets['EC/HOME/BTN_SIGNIN'] | default: 'Sign In' }}</a>
